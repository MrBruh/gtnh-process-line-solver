# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Node (previewer, if a build step is added later)
node_modules/

# Solver outputs (layouts, previews, schematics) - not source
out/
*.litematic
*.schematic
# ...but the hand-saved Schematica files under tests/golden/schematic/ are inputs, not outputs:
# they are the format reference the exporter (#96) is written against. See that dir's README.
!tests/golden/schematic/*.schematic

# Generated datasets are local-only and version-namespaced (data/<version>/{multiblocks,textures}/):
# regenerated on demand, never committed, so a user can hold several pack versions side by side.
# Only the small curated fixtures below ship (tests + out-of-box example previews). See
# docs/dataset-extraction/plan.md.
/data/*
!/data/multiblocks/
!/data/textures/
/data/multiblocks/*
!/data/multiblocks/_meta.json
!/data/multiblocks/gregtech_machine_1000.json
!/data/multiblocks/gregtech_machine_1001.json
/data/textures/*
!/data/textures/manifest.json

# Test fixtures derived from a local dump are local-only too, for the same reason and with no
# exception: dumper output never ships, not even a filtered slice of it. A test that needs one reads
# it from tests/fixtures/local/ and skips where it is absent; tools/derive_pipe_names.py writes the
# one there today from a staged data/<version>/ dump. The whole directory is ignored, so a file
# dropped into it is ignored by default rather than by someone remembering to. See docs/TESTING.md.
/tests/fixtures/local/

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
