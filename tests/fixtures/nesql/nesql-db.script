ALTER USER SA SET LOCAL TRUE
CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE PUBLIC.FLUID(ID VARCHAR(255) NOT NULL PRIMARY KEY,INTERNAL_NAME VARCHAR(255) NOT NULL,LOCALIZED_NAME VARCHAR(255) NOT NULL,MOD_ID VARCHAR(255) NOT NULL,IMAGE_FILE_PATH VARCHAR(255) NOT NULL,NBT VARCHAR(32767) NOT NULL,DENSITY INTEGER NOT NULL,FLUID_ID INTEGER NOT NULL,GASEOUS BOOLEAN NOT NULL,LUMINOSITY INTEGER NOT NULL,TEMPERATURE INTEGER NOT NULL,UNLOCALIZED_NAME VARCHAR(255) NOT NULL,VISCOSITY INTEGER NOT NULL)
CREATE MEMORY TABLE PUBLIC.ITEM(ID VARCHAR(255) NOT NULL PRIMARY KEY,LOCALIZED_NAME VARCHAR(255) NOT NULL,MOD_ID VARCHAR(255) NOT NULL,ITEM_DAMAGE INTEGER NOT NULL,INTERNAL_NAME VARCHAR(255) NOT NULL,NBT VARCHAR(32767),IMAGE_FILE_PATH VARCHAR(255) NOT NULL,ITEM_ID INTEGER NOT NULL,MAX_DAMAGE INTEGER NOT NULL,MAX_STACK_SIZE INTEGER NOT NULL,UNLOCALIZED_NAME VARCHAR(255) NOT NULL)
CREATE MEMORY TABLE PUBLIC.ITEM_TOOLTIP(ITEM_ID VARCHAR(255) NOT NULL,TOOLTIP VARCHAR(255),TOOLTIP_ORDER INTEGER NOT NULL,PRIMARY KEY(ITEM_ID,TOOLTIP_ORDER),CONSTRAINT FKBID6TIGHLM1X41DUNPXMGRYA2 FOREIGN KEY(ITEM_ID) REFERENCES PUBLIC.ITEM(ID))
CREATE MEMORY TABLE PUBLIC.METADATA(ID INTEGER NOT NULL PRIMARY KEY,CREATION_TIME_MILLIS BIGINT NOT NULL,VERSION VARCHAR(255) NOT NULL)
CREATE MEMORY TABLE PUBLIC.METADATA_ACTIVE_PLUGINS(METADATA_ID INTEGER NOT NULL,ACTIVE_PLUGINS VARCHAR(255),CONSTRAINT FKBGLUMWXI9LV429J2AFNHEV1E1 FOREIGN KEY(METADATA_ID) REFERENCES PUBLIC.METADATA(ID))
CREATE MEMORY TABLE PUBLIC.MOB_INFO_DROPS(MOB_INFO_ID VARCHAR(255) NOT NULL,DROPS_ITEM_ID VARCHAR(255),DROPS_LOOTABLE BOOLEAN NOT NULL,DROPS_PLAYER_ONLY BOOLEAN NOT NULL,DROPS_PROBABILITY DOUBLE NOT NULL,DROPS_STACK_SIZE INTEGER NOT NULL,DROPS_TYPE VARCHAR(255) NOT NULL,CONSTRAINT FK48L0X4W252POTO06H1ETPR7OK FOREIGN KEY(DROPS_ITEM_ID) REFERENCES PUBLIC.ITEM(ID))
CREATE CACHED TABLE PUBLIC.RECIPE(ID VARCHAR(255) NOT NULL PRIMARY KEY,RECIPE_TYPE_ID VARCHAR(255))
CREATE INDEX IDXCPA5258X6VHSI07ADBL3PRQ5M ON PUBLIC.RECIPE(RECIPE_TYPE_ID)
ALTER TABLE PUBLIC.MOB_INFO_DROPS ADD CONSTRAINT FKMW7M7V0W673IBYPF6V2IEFGIN FOREIGN KEY(DROPS_ITEM_ID) REFERENCES PUBLIC.ITEM(ID)
ALTER SEQUENCE SYSTEM_LOBS.LOB_ID RESTART WITH 1
SET DATABASE DEFAULT INITIAL SCHEMA PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.CARDINAL_NUMBER TO PUBLIC
GRANT DBA TO SA
